# Generate a password: openssl rand -hex 32
# Use URL-safe letters/digits (hex recommended); never commit .env.
POSTGRES_PASSWORD=replace_with_a_random_hex_password
DATABASE_URL=postgresql://crypto:${POSTGRES_PASSWORD}@postgres:5432/crypto_monitor?schema=public&connect_timeout=5&pool_timeout=5
BACKEND_PORT=3000
NODE_ENV=production
TZ=Asia/Seoul

# Optional until their respective implementation phases.
BITHUMB_ACCESS_KEY=
BITHUMB_SECRET_KEY=
# BITHUMB_API_KEY is also accepted as an alias for BITHUMB_ACCESS_KEY.
# Local portfolio access token, separate from exchange credentials: openssl rand -hex 32
PORTFOLIO_API_TOKEN=
DISCORD_WEBHOOK_URL=
OPENAI_API_KEY=
